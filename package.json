{
  "name": "urbanedge-land-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UrbanEdge Land Space V1",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/check-client-bundle-secrets.mjs",
    "build:turbo": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:social-image": "node scripts/generate-social-share-image.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:integration:local": "node scripts/run-local-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "playwright test --config playwright.responsive.config.ts",
    "test:e2e:local": "node scripts/run-local-e2e.mjs",
    "test:safety": "vitest run tests/unit/environment-safety.test.ts",
    "check:server-boundaries": "node scripts/check-server-boundaries.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:client-bundle-secrets": "node scripts/check-client-bundle-secrets.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:db:concurrency": "bash scripts/test-property-code-concurrency.sh",
    "qa": "npm run lint && npm run format:check && npm run typecheck && npm run check:server-boundaries && npm run check:secrets && npm run test:unit && npm run test:component && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.114.0",
    "maplibre-gl": "6.7.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "29.1.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
